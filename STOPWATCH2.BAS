10 GOSUB 1000:REM INIT
100 REM *** MAIN ***
110 GOSUB 1100:REM UPDATE NOW
120 GOSUB 1200:REM UPDATE ELAPSED
130 GOSUB 1300:REM UPDATE SCREEN
140 GOSUB 1400:REM HANDLE INPUT
150 IF QUIT THEN GOTO 200:REM EXIT
160 IF RESET THEN START=NOW
170 GOTO 100:REM MAIN
200 REM *** EXIT ***
210 GRAPHICS 0
215 POKE 752,0
220 END 
1000 REM *** INIT ***
1010 GRAPHICS 2
1015 POKE 752,1
1020 GOSUB 1100:REM UPDATE NOW
1030 START=NOW
1040 PRINT "--- STOPWATCH MENU ---"
1050 PRINT "PRESS (R) TO RESET"
1060 PRINT "PRESS (Q) TO QUIT"
1070 RETURN 
1100 REM *** UPDATE NOW ***
1110 T1=PEEK(18)*65536
1120 T2=PEEK(19)*256
1130 T3=PEEK(20)
1140 NOW=T1+T2+T3
1150 RETURN 
1200 REM *** UPDATE ELAPSED ***
1210 JIFFIES=NOW-START
1220 IF JIFFIES<0 THEN JIFFIES=JIFFIES+16777216
1230 ELAPSED=INT(JIFFIES/60)
1240 RETURN 
1300 REM *** UPDATE SCREEN ***
1310 MINUTES=INT(ELAPSED/60)
1320 SECONDS=ELAPSED-(MINUTES*60)
1330 POSITION 7,5
1350 IF MINUTES<10 THEN PRINT #6;"0";
1360 PRINT #6;MINUTES;":";
1370 IF SECONDS<10 THEN PRINT #6;"0";
1380 PRINT #6;SECONDS
1390 RETURN 
1400 REM *** HANDLE INPUT ***
1410 QUIT=0:RESET=0
1420 K=PEEK(764)
1430 POKE 764,255
1440 IF K=40 THEN RESET=1
1450 IF K=47 THEN QUIT=1
1460 RETURN 
