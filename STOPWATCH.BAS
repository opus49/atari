10 GRAPHICS 2
15 GOSUB 1600
20 GOSUB 1000
30 GOSUB 1500
100 REM ** MAIN LOOP **
110 GOSUB 1000
120 GOSUB 1200
130 GOSUB 1100
140 GOSUB 1300
150 IF QUIT THEN GOTO 1400
155 IF RESET=1 THEN GOSUB 1500
160 GOTO 110
1000 REM ** SET CURRENT TIME **
1010 T1=PEEK(18)*65536
1020 T2=PEEK(19)*256
1030 T3=PEEK(20)
1040 NOW=(T1+T2+T3)/60
1050 NOW=INT(NOW)
1060 RETURN 
1100 REM ** PRINT CURRENT TIME **
1110 MINUTES=INT(ELAPSED/60)
1120 POSITION 7,5
1130 IF MINUTES<10 THEN PRINT #6;"0";MINUTES
1140 IF MINUTES>=10 THEN PRINT #6;MINUTES
1150 POSITION 9,5
1155 PRINT #6;":"
1160 SECONDS=ELAPSED-(MINUTES*60)
1165 POSITION 10,5
1170 IF SECONDS<10 THEN PRINT #6;"0";SECONDS
1180 IF SECONDS>=10 THEN PRINT #6;SECONDS
1190 RETURN 
1200 REM ** SET ELAPSED **
1210 GOSUB 1000
1220 ELAPSED=NOW-START
1230 IF ELAPSED<0 THEN ELAPSED=ELAPSED+16777216
1240 RETURN 
1300 REM ** HANDLE USER INPUT **
1310 QUIT=0
1315 RESET=0
1320 K=PEEK(764)
1330 IF K=47 THEN QUIT=1
1335 IF K=40 THEN RESET=1
1340 POKE 764,255
1350 RETURN 
1400 REM ** END PROGRAM **
1410 GRAPHICS 0
1420 END 
1500 REM ** RESET TIME **
1510 START=NOW
1520 RESET=0
1530 RETURN 
1600 REM ** PRINT INSTRUCTIONS **
1610 PRINT "PRESS (R) TO RESET"
1620 PRINT "PRESS (Q) TO QUIT"
1630 RETURN 
